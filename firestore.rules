rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // CVs belong to their owner
    match /cvs/{cvId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Itineraries belong to their owner
    match /itineraries/{itinId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Jobs are public read, only admins write
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    // Candidates: company users can read candidates for their job postings
    match /candidates/{candidateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Job postings: company users manage their own
    match /jobPostings/{postingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company';
    }
  }
}
